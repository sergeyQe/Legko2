# Настройки боевого запуска. Скопируйте в .env.prod на сервере и заполните.

# Адрес сайта. С sslip.io: IP сервера через дефисы или точки + .sslip.io
# Пример для IP 203.0.113.10: 203-0-113-10.sslip.io
SITE_ADDRESS=203-0-113-10.sslip.io

# Пароль БД: только буквы и цифры (он попадает в адрес подключения). Сгенерировать: openssl rand -hex 16
POSTGRES_PASSWORD=замените-на-длинный-пароль

# Необязательно
# LOG_LEVEL=INFO
