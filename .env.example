# Скопируйте в .env и при необходимости поправьте значения.

# --- PostgreSQL (docker-compose.yml и приложение) ---
POSTGRES_USER=legko2
POSTGRES_PASSWORD=legko2
POSTGRES_DB=legko2
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://legko2:legko2@localhost:5432/legko2

# --- Keitaro (общий тестовый стенд) ---
KEITARO_URL=https://your-keitaro.example.com
KEITARO_API_KEY=
KEITARO_TIMEOUT_SECONDS=10

# Префикс названий кампаний. Стенд общий: сервис видит и меняет только кампании, названия которых начинаются
# с этого префикса, а новые кампании получает его автоматически. Обязателен. Формат: test_<фамилия>_
CAMPAIGN_PREFIX=test_surname_

# Значения по умолчанию для создания кампании (названия, ID ищутся через API Keitaro)
DEFAULT_DOMAIN=kylovoa.com
DEFAULT_GROUP=FORTESTS
DEFAULT_SOURCE=FORTESTS

# --- Приложение ---
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
