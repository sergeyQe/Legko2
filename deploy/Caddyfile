# Caddy: отдаёт собранный фронтенд и проксирует /api/* на бэкенд (один адрес, CORS не нужен).
# SITE_ADDRESS задаётся в .env.prod: например 203-0-113-10.sslip.io (HTTPS и сертификат Caddy получит сам).
{$SITE_ADDRESS:localhost} {
	encode gzip

	# заголовки безопасности для всего сайта; информация о сервере не раскрывается
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	# префикс /api отрезается: бэкенд видит обычные маршруты (/campaigns, /health, ...)
	# ответы API не кешируются (там данные потоков); у Swagger (/api/docs) своя страница без CSP: он грузит скрипты с CDN
	handle_path /api/* {
		header {
			Cache-Control "no-store"
			-Via
		}
		reverse_proxy backend:8000 {
			header_down -Server
		}
	}

	handle {
		# CSP для самого сайта: всё своё, без сторонних адресов (шрифты и скрипты лежат рядом с сайтом)
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		root * /srv
		# страница всегда проверяется заново, файлы сборки с хешем в имени кешируются надолго
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
